  "tokenColors": [
    {
      "name": "Plain text / Default",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#e5e7eb"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#63646b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.double-slash.documentation"
      ],
      "settings": {
        "foreground": "#63646c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords — control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.void",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#6b7280"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant",
        "meta.object-binding-pattern-variable"
      ],
      "settings": {
        "foreground": "#e5e7eb"
      }
    },
    {
      "name": "Variable — this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#22ec68",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#cbeefa"
      }
    },
    {
      "name": "Properties / Object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.objectliteral entity.name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#9ca3af"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#16a34a"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#16a34a"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type",
        "meta.class entity.name.type"
      ],
      "settings": {
        "foreground": "#0a84ff"
      }
    },
    {
      "name": "Interfaces / Type aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#3b82f6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "support.module",
        "support.other.module"
      ],
      "settings": {
        "foreground": "#047cff"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#0a84ff"
      }
    },
    {
      "name": "Decorators / Annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "support.type.decorator"
      ],
      "settings": {
        "foreground": "#4ade80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Template literals / string interpolation",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression",
        "string.template punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Template expression — content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#e5e7eb"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape", "constant.character.entity"],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "source.regexp"],
      "settings": {
        "foreground": "#9ca3af"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#16a34a"
      }
    },
    {
      "name": "Booleans / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan"
      ],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#22ec68"
      }
    },
    {
      "name": "Punctuation — brackets / delimiters",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.section.block",
        "punctuation.section.array",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
