  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#736350",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "#746350",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f5353d"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#8A7D6E"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#f5353d"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Variable — this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#f5353d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#F5C200"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#cb652d"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#0f955e"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#0f955e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#0f955e"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#0f955e"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#F5C200",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple"
      ],
      "settings": {
        "foreground": "#F5C200"
      }
    },
    {
      "name": "Template literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#F5C200"
      }
    },
    {
      "name": "Template expression content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "Booleans / null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#f5353d"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#cb652d"
      }
    },
    {
      "name": "Punctuation — brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "punctuation.section.block",
        "punctuation.section.array"
      ],
      "settings": {
        "foreground": "#7A6A58"
      }
    },
    {
      "name": "Punctuation — accessor",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#736350"
      }
    },
    {
      "name": "HTML — Tags",
      "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "HTML — Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#736350"
      }
    },
    {
      "name": "HTML — Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#F5C200"
      }
    },
    {
      "name": "CSS — Selectors",
      "scope": ["entity.name.tag.css", "meta.selector"],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "CSS — Properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#F5C200"
      }
    },
    {
      "name": "Python — self",
      "scope": ["variable.parameter.function.language.special.self.python"],
      "settings": {
        "foreground": "#f5353d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — decorators",
      "scope": ["entity.name.function.decorator.python"],
      "settings": {
        "foreground": "#F5C200",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — magic",
      "scope": ["support.function.magic.python"],
      "settings": {
        "foreground": "#0f955e"
      }
    },
    {
      "name": "Markdown — Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#E8620A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#F5F0E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#F5C200",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown — Inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Markdown — Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#E8620A"
      }
    },
    {
      "name": "JSON — Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "YAML — Keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F5F0E8",
        "background": "#f5353d"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#0f955e",
    "type": "#0f955e",
    "type.declaration": {
      "foreground": "#0f955e",
      "bold": true
    },
    "class": "#0f955e",
    "class.declaration": {
      "foreground": "#0f955e",
      "bold": true
    },
    "interface": {
      "foreground": "#0f955e",
      "italic": true
    },
    "enum": "#0f955e",
    "enumMember": "#E8A055",
    "typeParameter": {
      "foreground": "#0f955e",
      "italic": true
    },
    "function": "#E8620A",
    "function.declaration": {
      "foreground": "#E8620A",
      "bold": false
    },
    "method": "#E8620A",
    "method.declaration": "#E8620A",
    "macro": "#cb652d",
    "decorator": {
      "foreground": "#F5C200",
      "italic": true
    },
    "variable": "#F5F0E8",
    "variable.constant": "#cb652d",
    "variable.defaultLibrary": {
      "foreground": "#C8B8A0",
      "italic": true
    },
    "parameter": "#F5C200",
    "property": "#E8A055",
    "keyword": "#f5353d",
    "modifier": "#f5353d",
    "string": "#F5C200",
    "number": "#E8620A",
    "regexp": "#E8A055",
    "operator": "#8A7D6E",
    "comment": {
      "foreground": "#736350",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#f5353d",
      "italic": true
    },
    "builtinType": "#0f955e"
  }
}
