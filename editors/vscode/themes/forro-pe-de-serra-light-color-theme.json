  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#746f68"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#70604E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "#7A6A58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#c54400"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#746f68"
      }
    },
    {
      "name": "Variable — this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#b65214",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#a26000"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#996500"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#c54400"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#c54400"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#59784e"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#59784e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#59784e"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#59784e"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#996500",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple"
      ],
      "settings": {
        "foreground": "#a26000"
      }
    },
    {
      "name": "Template literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#a26000"
      }
    },
    {
      "name": "Template expression content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#746f68"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#c54400"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#996500"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#c54400"
      }
    },
    {
      "name": "Booleans / null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ac5922"
      }
    },
    {
      "name": "Punctuation — brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "punctuation.section.block",
        "punctuation.section.array"
      ],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Punctuation — accessor",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7A6A58"
      }
    },
    {
      "name": "HTML — Tags",
      "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "HTML — Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#70604E"
      }
    },
    {
      "name": "HTML — Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#996500"
      }
    },
    {
      "name": "CSS — Selectors",
      "scope": ["entity.name.tag.css", "meta.selector"],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
      "name": "CSS — Properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#996500"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#a26000"
      }
    },
    {
      "name": "Python — self",
      "scope": ["variable.parameter.function.language.special.self.python"],
      "settings": {
        "foreground": "#b65214",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — decorators",
      "scope": ["entity.name.function.decorator.python"],
      "settings": {
        "foreground": "#996500",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — magic",
      "scope": ["support.function.magic.python"],
      "settings": {
        "foreground": "#59784e"
      }
    },
    {
      "name": "Markdown — Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#b65214",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#746f68",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#a26000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown — Inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#996500"
      }
    },
    {
      "name": "Markdown — Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#b65214"
      }
    },
    {
