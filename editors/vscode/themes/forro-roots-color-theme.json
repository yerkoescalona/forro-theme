    {
      "name": "CSS — Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name",
        "entity.name.tag.css support.type.property-name"
      ],
      "settings": {
        "foreground": "#D4A85A"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
