    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#F4EFE0",
        "background": "#5C3020"
      }
    }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#8B9E7A",
    "namespace.declaration": { "foreground": "#8B9E7A", "bold": true },
    "type": "#7A9870",
    "type.declaration": { "foreground": "#7A9870", "bold": true },
    "class": "#7A9870",
    "class.declaration": { "foreground": "#7A9870", "bold": true },
    "interface": { "foreground": "#6A8A68", "italic": true },
    "enum": "#7A9870",
    "enumMember": "#D4A85A",
    "typeParameter": { "foreground": "#6A8A68", "italic": true },
    "function": "#D4622A",
    "function.declaration": { "foreground": "#D4622A", "bold": false },
    "method": "#D4622A",
