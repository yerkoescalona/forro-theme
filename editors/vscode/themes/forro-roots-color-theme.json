    "variable.defaultLibrary": { "foreground": "#C8B8A0", "italic": true },
    "parameter": "#E8C878",
    "property": "#D4A85A",
    "keyword": "#cb652d",
    "modifier": "#cb652d",
    "string": "#B5821A",
    "number": "#D4622A",
    "regexp": "#D4A85A",
