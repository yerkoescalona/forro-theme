  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#F5E6D3"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#70604E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "#7A6A58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F5E6D3"
      }
    },
    {
      "name": "Variable — this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#BE6A1E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#D4916A"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#5A9A5A"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#6AAA70",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#6AAA70"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#5A9A5A"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D4916A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Template literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Template expression content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#F5E6D3"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#D4916A"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Booleans / null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "Punctuation — brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "punctuation.section.block",
        "punctuation.section.array"
      ],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Punctuation — accessor",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7A6A58"
      }
    },
    {
      "name": "HTML — Tags",
      "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "HTML — Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#70604E"
      }
    },
    {
      "name": "HTML — Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#D4916A"
      }
    },
    {
      "name": "CSS — Selectors",
      "scope": ["entity.name.tag.css", "meta.selector"],
      "settings": {
        "foreground": "#BE6A1E"
      }
    },
    {
      "name": "CSS — Properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#D4916A"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Python — self",
      "scope": ["variable.parameter.function.language.special.self.python"],
      "settings": {
        "foreground": "#BE6A1E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — decorators",
      "scope": ["entity.name.function.decorator.python"],
      "settings": {
        "foreground": "#D4916A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — magic",
      "scope": ["support.function.magic.python"],
      "settings": {
        "foreground": "#5A9A5A"
      }
    },
    {
      "name": "Markdown — Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#BE6A1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#F5E6D3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#D4916A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown — Inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
