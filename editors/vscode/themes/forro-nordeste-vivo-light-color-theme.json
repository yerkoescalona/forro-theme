  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#76726b"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#736350",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "#746350",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e1182c"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#8A7D6E"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#e1182c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#76726b"
      }
    },
    {
      "name": "Variable — this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#e1182c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#996900"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#a56302"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#b95518"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#00834f"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#00834f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#00834f"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#00834f"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#996900",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple"
      ],
      "settings": {
        "foreground": "#996900"
      }
    },
    {
      "name": "Template literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#996900"
      }
    },
    {
      "name": "Template expression content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#76726b"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#a56302"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "Booleans / null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#e1182c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#b95518"
      }
    },
    {
      "name": "Punctuation — brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "punctuation.section.block",
        "punctuation.section.array"
      ],
      "settings": {
        "foreground": "#7A6A58"
      }
    },
    {
      "name": "Punctuation — accessor",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#736350"
      }
    },
    {
      "name": "HTML — Tags",
      "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "HTML — Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#736350"
      }
    },
    {
      "name": "HTML — Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#996900"
      }
    },
    {
      "name": "CSS — Selectors",
      "scope": ["entity.name.tag.css", "meta.selector"],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "CSS — Properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#a56302"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#996900"
      }
    },
    {
      "name": "Python — self",
      "scope": ["variable.parameter.function.language.special.self.python"],
      "settings": {
        "foreground": "#e1182c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — decorators",
      "scope": ["entity.name.function.decorator.python"],
      "settings": {
        "foreground": "#996900",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — magic",
      "scope": ["support.function.magic.python"],
      "settings": {
        "foreground": "#00834f"
      }
    },
    {
      "name": "Markdown — Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#ca4600",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#76726b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#996900",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown — Inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#a56302"
      }
    },
    {
      "name": "Markdown — Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#ca4600"
      }
    },
    {
      "name": "JSON — Keys",
      "scope": ["support.type.property-name.json"],
