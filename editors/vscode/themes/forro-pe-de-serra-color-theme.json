  "tokenColors": [
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#70604E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "#7A6A58",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.class",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#D4521A"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Variable — this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#C8622A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "Functions — declarations",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": {
        "foreground": "#D4521A"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#D4521A"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin", "support.function.console"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Classes / Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#6B8B60"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#6B8B60",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces / Modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#6B8B60"
      }
    },
    {
      "name": "Type annotations",
      "scope": [
        "entity.name.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#6B8B60"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#C8920A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Template literals",
      "scope": [
        "string.template",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Template expression content",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#F5F0E8"
      }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#D4521A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#D4521A"
      }
    },
    {
      "name": "Booleans / null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#b9632f"
      }
    },
    {
      "name": "Punctuation — brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.brackets",
        "meta.brace",
        "punctuation.section.block",
        "punctuation.section.array"
      ],
      "settings": {
        "foreground": "#8A7A68"
      }
    },
    {
      "name": "Punctuation — accessor",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7A6A58"
      }
    },
    {
      "name": "HTML — Tags",
      "scope": ["entity.name.tag", "meta.tag", "support.class.component"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "HTML — Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#70604E"
      }
    },
    {
      "name": "HTML — Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "CSS — Selectors",
      "scope": ["entity.name.tag.css", "meta.selector"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "CSS — Properties",
      "scope": ["support.type.property-name.css", "support.type.property-name"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "CSS — Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#E8A055"
      }
    },
    {
      "name": "Python — self",
      "scope": ["variable.parameter.function.language.special.self.python"],
      "settings": {
        "foreground": "#C8622A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — decorators",
      "scope": ["entity.name.function.decorator.python"],
      "settings": {
        "foreground": "#C8920A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — magic",
      "scope": ["support.function.magic.python"],
      "settings": {
        "foreground": "#6B8B60"
      }
    },
    {
      "name": "Markdown — Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#C8622A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#F5F0E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown — Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#E8A055",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown — Inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "Markdown — Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#C8622A"
      }
    },
    {
      "name": "JSON — Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "YAML — Keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#C8920A"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F5F0E8",
        "background": "#D4521A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#6B8B60",
    "type": "#6B8B60",
    "type.declaration": {
      "foreground": "#6B8B60",
      "bold": true
    },
    "class": "#6B8B60",
    "class.declaration": {
      "foreground": "#6B8B60",
      "bold": true
    },
    "interface": {
      "foreground": "#6B8B60",
      "italic": true
    },
    "enum": "#6B8B60",
    "enumMember": "#C8920A",
    "typeParameter": {
      "foreground": "#6B8B60",
      "italic": true
    },
    "function": "#D4521A",
    "function.declaration": {
      "foreground": "#D4521A",
      "bold": false
    },
    "method": "#D4521A",
    "method.declaration": "#D4521A",
    "macro": "#C8622A",
    "decorator": {
      "foreground": "#C8920A",
      "italic": true
    },
    "variable": "#F5F0E8",
    "variable.constant": "#b9632f",
    "variable.defaultLibrary": {
      "foreground": "#C8B8A0",
      "italic": true
    },
    "parameter": "#E8A055",
    "property": "#C8920A",
    "keyword": "#C8622A",
    "modifier": "#C8622A",
    "string": "#E8A055",
    "number": "#D4521A",
    "regexp": "#C8920A",
    "operator": "#8A7A68",
    "comment": {
      "foreground": "#70604E",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#C8622A",
      "italic": true
    },
    "builtinType": "#6B8B60"
  }
}
